stage           = "regional_airfield"
root_id         = "airstrip"
subscription_id = "33333333-3333-4333-8333-333333333333"
name            = "erp"
location        = "westeurope"
tags            = { owner = "erp-team", cost-center = "erp", env = "prod" }
address_space   = ["10.1.0.0/16"]

# Keep this list current in every spoke when adding another spoke.
other_spoke_prefixes = []

# Supply hub through hub.tfvars.json, exported from the connectivity root.
subnets = {
  apps = {
    address_prefixes = ["10.1.1.0/24"]
    rules = {
      private-services = {
        priority                   = 200
        direction                  = "Outbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        destination_port_range     = "443"
        source_address_prefix      = "10.1.1.0/24"
        destination_address_prefix = "10.1.2.0/24"
      }
    }
  }
  private-endpoints = {
    address_prefixes  = ["10.1.2.0/24"]
    private_endpoints = true
    rules = {
      apps-https = {
        priority                   = 200
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        destination_port_range     = "443"
        source_address_prefix      = "10.1.1.0/24"
        destination_address_prefix = "10.1.2.0/24"
      }
    }
  }
}
